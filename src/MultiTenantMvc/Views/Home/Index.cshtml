@model MultiTenantMvc.Models.HomeViewModel
@{
    ViewData["Title"] = $"{Model.CurrentTenant.Name} - Home (Base View)";
}

<div class="row g-4">
    <!-- Hero / Status Banner -->
    <div class="col-12">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-primary mb-2">Base View Template</span>
                    <h1 class="h3 fw-bold text-dark mb-1">@Model.CurrentTenant.Name</h1>
                    <p class="text-muted mb-0">@Model.CurrentTenant.Description</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-secondary">Resolution: @Model.ResolutionSource</span>
                    <div class="small text-muted mt-1">Tenant ID: <code>@Model.CurrentTenant.Id</code></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3-Tier Multi-Tenancy Architecture Diagnostic Table -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">Multi-Tenancy Layer Status & Overrides</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Layer</th>
                            <th>Resolution Mechanism</th>
                            <th>Status for @Model.CurrentTenant.Id</th>
                            <th>Resolved File / Implementation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 1. C# Backend Logic -->
                        <tr>
                            <td><strong class="text-primary">1. C# Logic (.cs)</strong></td>
                            <td>Keyed DI Service (<code>ITenantDiscountService</code>)</td>
                            <td>
                                @if (Model.Discount.ServiceClass == "AlphaDiscountService")
                                {
                                    <span class="badge bg-success">Custom Tenant Override</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Global Base Fallback</span>
                                }
                            </td>
                            <td>
                                <code>@(Model.Discount.ServiceClass).cs</code>
                                <div class="small text-muted">@Model.Discount.CustomNotes</div>
                            </td>
                        </tr>

                        <!-- 2. Razor View (.cshtml) -->
                        <tr>
                            <td><strong class="text-primary">2. Razor View (.cshtml)</strong></td>
                            <td>Custom <code>TenantViewLocationExpander</code></td>
                            <td>
                                <span class="badge bg-secondary">Global Base View (Views/Home/Index.cshtml)</span>
                            </td>
                            <td>
                                <code>Views/Home/Index.cshtml</code>
                                <div class="small text-muted">Standard view rendered because no tenant-specific override was provided.</div>
                            </td>
                        </tr>

                        <!-- 3. Client Script (.js) -->
                        <tr>
                            <td><strong class="text-primary">3. Script (.js)</strong></td>
                            <td><code>&lt;tenant-script&gt;</code> TagHelper</td>
                            <td>
                                @if (Model.ScriptIsOverridden)
                                {
                                    <span class="badge bg-warning text-dark">Tenant Beta Custom Override!</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Global Base Fallback (/js/site.js)</span>
                                }
                            </td>
                            <td>
                                <code>@Model.ScriptFileExpected</code>
                                <div class="small text-muted">Resolved dynamically by inspecting disk/WebRootFileProvider.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- C# Logic Demonstration Card -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">1. C# Business Logic (.cs) Demonstration</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    This section calls <code>ITenantDiscountService.CalculateDiscount()</code>. Notice which service implementation handled the calculation:
                </p>

                <form method="get" class="row g-2 mb-3">
                    <input type="hidden" name="tenant" value="@Model.CurrentTenant.Id" />
                    <div class="col-8">
                        <label class="form-label small fw-semibold">Order Subtotal ($):</label>
                        <input type="number" step="50" name="amount" value="@Model.Discount.OriginalAmount" class="form-control" />
                    </div>
                    <div class="col-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Calculate</button>
                    </div>
                </form>

                <ul class="list-group list-group-flush border rounded-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Original Amount:</span>
                        <strong>@Model.Discount.OriginalAmount.ToString("C")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Discount Rate:</span>
                        <strong class="text-success">@Model.Discount.DiscountPercentage%</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Discount Amount:</span>
                        <strong class="text-success">-@Model.Discount.DiscountAmount.ToString("C")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between bg-light">
                        <span class="fw-bold">Final Amount:</span>
                        <strong class="text-primary fs-5">@Model.Discount.FinalAmount.ToString("C")</strong>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Client-Side JavaScript (.js) Demonstration Card -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">3. JavaScript (.js) Execution Output</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    The block below is populated live in the browser by the loaded JavaScript file:
                </p>

                <!-- This element will be updated dynamically by either /js/site.js or /tenants/beta/js/site.js -->
                <div id="tenant-js-output" class="p-3 border rounded-3 bg-light">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                    <span class="text-muted ms-2">Waiting for client-side JavaScript execution...</span>
                </div>

                <div class="mt-3">
                    <div class="small text-muted">
                        <strong>Expected Behavior:</strong>
                        <ul class="mb-0 ps-3 mt-1">
                            <li><strong>Base site & Tenant Alpha:</strong> Executes <code>/js/site.js</code> (Base standard message).</li>
                            <li><strong>Tenant Beta:</strong> Executes <code>/tenants/beta/js/site.js</code> (Custom interactive widget & distinct Beta styling).</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
